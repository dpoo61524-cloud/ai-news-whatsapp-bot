# Application Configuration
ENV=development
LOG_LEVEL=INFO

# LLM & Embedding API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Persistence & Thresholds
CHROMA_PERSIST_DIR=./chroma_db
SIMILARITY_THRESHOLD=0.85

# Relational Database Connection (SQLite default, PostgreSQL for production)
# SQLite default: sqlite:///./news_agents.db
# PostgreSQL: postgresql+psycopg2://news_user:news_pass@localhost:5432/news_db
DATABASE_URL=sqlite:///./news_agents.db

# WhatsApp Webhook Integration Credentials
WHATSAPP_VERIFY_TOKEN=news_agents_verify_token
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
